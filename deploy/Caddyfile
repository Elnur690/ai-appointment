# ==============================================================================
# Caddyfile — Production Reverse Proxy & Auto-SSL for randevu.vip
# ==============================================================================
# Subdomains:
#   - https://randevu.vip & https://app.randevu.vip  -> Business & Salon Portal (127.0.0.1:22301)
#   - https://admin.randevu.vip                      -> SaaS Owner & Reseller Admin (127.0.0.1:22300)
#   - https://api.randevu.vip                        -> FastAPI Backend REST API (127.0.0.1:22800)
#   - https://cname.randevu.vip                      -> White-Label Custom Domain Target
# ==============================================================================

randevu.vip, www.randevu.vip, app.randevu.vip {
    encode gzip zstd
    reverse_proxy 127.0.0.1:22301
}

admin.randevu.vip {
    encode gzip zstd
    reverse_proxy 127.0.0.1:22300
}

api.randevu.vip {
    encode gzip zstd
    reverse_proxy 127.0.0.1:22800
}
