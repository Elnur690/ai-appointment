# ==========================================
# AI Appointment SaaS — Master Environment Template
# ==========================================

# ------------------------------------------
# 1. Environment & Security Settings
# ------------------------------------------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-prod-super-secure-key-9988776655
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:22300,http://localhost:22301

# ------------------------------------------
# 2. Database (PostgreSQL 16 + pgvector)
# ------------------------------------------
POSTGRES_USER=appointment
POSTGRES_PASSWORD=appointment_secret
POSTGRES_DB=ai_appointment
POSTGRES_PORT=22432
DATABASE_URL=postgresql+asyncpg://appointment:appointment_secret@postgres:5432/ai_appointment

# ------------------------------------------
# 3. Redis & Celery Task Queue
# ------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------
# 4. WhatsApp (Evolution API v2 Settings)
# ------------------------------------------
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me-evolution-key
SERVER_URL=http://localhost:22880
DOCKER_ENV=true
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=change-me-evolution-key
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://appointment:appointment_secret@postgres:5432/ai_appointment?schema=evolution
DATABASE_CLIENT_NAME=evolution_v2
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/3
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=true
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://backend:8000/api/v1/webhooks/whatsapp
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=true

# ------------------------------------------
# 5. Multi-Model AI API Keys & Defaults
# ------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_RPM=15
GEMINI_MAX_RPD=1500
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------
# 6. Azerbaijan Payment Gateways
# ------------------------------------------
PAYRIFF_MERCHANT_ID=PRF_99841
PAYRIFF_SECRET_KEY=change_me_payriff_secret
EPOINT_PUBLIC_KEY=EP_88291
EPOINT_PRIVATE_KEY=change_me_epoint_private

# ------------------------------------------
# 7. SaaS Admin Initial Credentials
# ------------------------------------------
SAAS_ADMIN_EMAIL=admin@platform.com
SAAS_ADMIN_PASSWORD=change_me_admin_password

# ------------------------------------------
# 8. Frontend Dashboards Config
# ------------------------------------------
VITE_API_URL=http://localhost:22800
